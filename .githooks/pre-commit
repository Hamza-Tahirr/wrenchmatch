#!/bin/sh
# Credential guard: refuses a commit that contains a secret (scripts/check-secrets.mjs).
# Runs for commits from the terminal and from GitHub Desktop alike.
if ! command -v node >/dev/null 2>&1; then
  echo "Credential guard: Node.js was not found, so the commit was stopped to stay safe." >&2
  echo "Install Node.js (https://nodejs.org) or commit from a terminal where 'node' works." >&2
  exit 1
fi
exec node scripts/check-secrets.mjs --staged
