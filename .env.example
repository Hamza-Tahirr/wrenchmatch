# Copy to .env.local (ignored by git). Local development needs no secrets: it uses a SQLite
# file and a private upload folder. The hosted site on Vercel is configured in the Vercel
# project settings instead (see docs/DEPLOY.md). Never put hosted credentials in .env.local
# (or .env.production*): `npm run dev`, `npm run build` and `npm start` read those files, so
# the local app would use the hosted database.

# SQLite database file (created by `npm run db:reset`)
DATABASE_PATH=.data/app.db

# Private upload directory (outside public/, served only through /api/files/[id])
UPLOAD_DIR=.data/uploads

# One-click sample-account logins on /login. They work only for requests to localhost (other
# addresses never see the panel) and must never be enabled for real accounts (when unset: on
# in development, off in a production build). Leave it unset on Vercel.
DEMO_MODE=true

# Build output folder for `next dev` / `next build` (default .next). A trial build or a
# second dev server can use its own folder without touching the one `npm start` serves:
#   NEXT_DIST_DIR=.next-check npx next build
# NEXT_DIST_DIR=

# --- Hosted mode (Vercel project settings; see docs/DEPLOY.md) ----------------------
# Set in the Vercel project, not here. The scripts that work on the hosted site
# (npm run db:push:remote, db:migrate:remote, uploads:push:remote) read them from the
# environment or from .env.vercel, a git-ignored file made with
# `vercel env pull .env.vercel --environment=production`.
#
# Turso (hosted libSQL, SQLite-compatible). When TURSO_DATABASE_URL is set, the app uses
# this database instead of DATABASE_PATH. Added by the Turso integration.
# TURSO_DATABASE_URL=libsql://wrenchmatch-db-<your-org>.aws-ap-south-1.turso.io
# TURSO_AUTH_TOKEN=
#
# Vercel Blob (a private store). When BLOB_READ_WRITE_TOKEN (or BLOB_STORE_ID, which newer
# store connections add for sign-in with Vercel's OIDC token) is set, uploads are stored in
# the Blob store instead of UPLOAD_DIR, still served only through /api/files/[id] after a
# permission check. Vercel adds them when you connect the store to the project.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
#
# Most bytes of files one form may send (default on Vercel: 4194304, i.e. 4 MiB, under the
# platform's 4.5 MB request limit; no limit beyond the per-file ones elsewhere). Set it
# locally to try the hosted upload behaviour: photos are shrunk in the browser first.
# HOSTED_UPLOAD_MAX_BYTES=4194304

# --- Client IP for the per-IP limits (failed logins, sign-ups) ----------------------
# The app reads the first X-Forwarded-For entry. On Vercel that is reliable: the platform
# sets X-Forwarded-For itself and overwrites any value the client sent.
# Self-hosted, there is no TRUST_PROXY setting on purpose. Next.js fills in X-Forwarded-For
# from the socket only when a request arrives without one, so the app cannot tell a proxy's
# header from one a client sent itself. A self-hosted production server must therefore run
# behind a reverse proxy that OVERWRITES X-Forwarded-For with the address it accepted the
# connection from, e.g. nginx
#   proxy_set_header X-Forwarded-For $remote_addr;
# (not $proxy_add_x_forwarded_for, which keeps the client's own value as the first entry,
# and the app reads the first entry). Without such a proxy a client can choose its own
# address, so the per-email and per-user limits remain the main protection.

# --- Later phases (server-only; never prefix with NEXT_PUBLIC_) ---------------------
# Hosted Supabase (when replacing SQLite):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
#
# Stripe Connect + Checkout (payments are NOT connected in this build):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
