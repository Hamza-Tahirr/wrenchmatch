{
  "name": "wrenchmatch-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first car repair marketplace MVP (development/demo build, SQLite, payments not connected).",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:libsql": "vitest run --mode libsql tests/integration",
    "test:e2e": "playwright test",
    "secrets:check": "node scripts/check-secrets.mjs --all",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:remote": "tsx scripts/db-migrate.ts --remote",
    "db:push:remote": "tsx scripts/db-push-remote.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:types": "tsx scripts/gen-db-types.ts",
    "uploads:push:remote": "tsx scripts/push-uploads-remote.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@libsql/kysely-libsql": "0.4.1",
    "@vercel/blob": "2.8.0",
    "better-sqlite3": "13.0.3",
    "kysely": "0.29.6",
    "lucide-react": "1.51.0",
    "maplibre-gl": "6.11.2",
    "motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "latest",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
